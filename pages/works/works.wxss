/* ---------------- 我的 ---------------- */
.profile {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  display: block;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper);
  color: #c3b6a8;
  font-size: 44rpx;
  box-sizing: border-box;
}

.profile-info {
  flex: 1;
  overflow: hidden;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--winter-brown);
  height: 48rpx;
}

.profile-meta {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}

/* ---------------- 功能入口 ---------------- */
.mine-links {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
  margin-bottom: 40rpx;
}

.mine-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.mine-link-last {
  border-bottom: none;
}

.mine-link-text {
  font-size: 28rpx;
  color: var(--winter-brown);
}

.mine-arrow {
  color: #c3b6a8;
  font-size: 34rpx;
}

/* ---------------- 作品列表 ---------------- */
.works-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-link {
  font-size: 26rpx;
  color: var(--spring-green);
  padding: 0 8rpx;
}

.work-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(107, 91, 74, 0.06);
}

.work-card:active {
  opacity: 0.9;
}

.work-img-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #e8e0d0 0%, #d9cfbd 100%);
}

.work-img {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.work-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.work-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--winter-brown);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-meta {
  display: flex;
  align-items: center;
}

.work-date {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-left: 16rpx;
}

.loading-text {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #c3b6a8;
}

.empty-btn {
  width: 320rpx;
  margin: 0 auto;
}

/* ---------------- 悬浮按钮 ---------------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--spring-green);
  color: #ffffff;
  font-size: 56rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(124, 154, 109, 0.4);
  z-index: 10;
}

.fab:active {
  opacity: 0.85;
}
