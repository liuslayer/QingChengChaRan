.brand {
  padding: 20rpx 0 32rpx;
  text-align: center;
}

.brand-title {
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--winter-brown);
}

.brand-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--spring-green);
}

/* ---------------- 横幅 ---------------- */
.banner {
  margin-bottom: 44rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  display: block;
  border: 2rpx solid var(--line);
}

/* ---------------- 青城四色 ---------------- */
.colors {
  display: flex;
  justify-content: space-between;
}

.color-item {
  width: 23%;
  text-align: center;
}

.color-block {
  height: 150rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(107, 91, 74, 0.12);
}

.color-season {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
}

.color-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--winter-brown);
}

.color-name-active {
  color: var(--spring-green);
  font-weight: 600;
}

.color-desc {
  margin-top: 26rpx;
}

.color-desc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--spring-green);
  margin-bottom: 8rpx;
}

.color-desc-text {
  font-size: 26rpx;
  color: var(--winter-brown);
}

.color-hint {
  margin-top: 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: #c3b6a8;
}

/* ---------------- 入口按钮 ---------------- */
.entry .btn {
  margin-bottom: 24rpx;
}

.entry .btn:last-child {
  margin-bottom: 0;
}

/* ---------------- 底部一句话 ---------------- */
.slogan {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-weak);
  letter-spacing: 1rpx;
}
