<view class="page-wrap">

  <!-- 简介 -->
  <view class="section">
    <view class="section-title">关于我们</view>
    <view class="card">
      <view class="about-title">青城拾色 · 一叶一染</view>
      <view class="about-text">{{about.intro}}</view>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="section">
    <view class="section-title">联系传承人 / 老师</view>
    <view class="card contact-card">

      <view class="contact-item">
        <view class="contact-label">传承人 / 老师</view>
        <view class="contact-value">{{contact.teacherName}}</view>
      </view>

      <view class="contact-item">
        <view class="contact-label">手机号</view>
        <view class="contact-value">
          <text class="contact-link" catchtap="onCall">{{contact.phone}}</text>
        </view>
      </view>

      <view class="contact-item">
        <view class="contact-label">微信号</view>
        <view class="contact-value">
          <text class="contact-link" catchtap="onCopyWechat">{{contact.wechat}}</text>
        </view>
      </view>

      <view class="contact-item contact-item-last">
        <view class="contact-label">地址</view>
        <view class="contact-value">
          <text class="contact-link" catchtap="onCopyAddress">{{contact.address}}</text>
        </view>
      </view>

    </view>
    <view class="muted contact-note">点手机号可直接拨号，点微信号 / 地址可复制</view>
  </view>

  <!-- 版本 -->
  <view class="version">青城拾色 v{{about.version}}</view>

</view>
